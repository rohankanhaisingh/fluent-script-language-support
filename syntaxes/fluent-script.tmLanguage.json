{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Fluent Script",
	"scopeName": "source.fluentscript",
	"fileTypes": [
		"fls"
	],
	"uuid": "d25a87c4-812c-11ec-a8a3-0242ac120002",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#decorators"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.fluentscript",
					"match": "(?<![\\w-])&(pointer|address|length|alloc)\\b"
				},
				{
					"name": "keyword.control.fluentscript",
					"match": "\\b(import|from|return|if|else|as|or|of|while|loop|for|throw|export|type|where|try|catch|in|switch|case|break|exit|unsafe|is|and)\\b"
				},
				{
					"name": "keyword.other.fluentscript",
					"match": "\\b(var|func|to|true|false|void|null|class|public|private|protected|declare|constructor|this|ref|deref|exists|interface|override|extends|required|default|location|struct|mut|enum|implements|global|optional|namespace|use|internal|binding)\\b"
				},
				{
					"name": "entity.name.function.fluentscript",
					"match": "\\b(Get-|Set-|Write-|On-|Register-|Remove-|Enumerate-|New-|Register-|Start-|Read-|Add-|From-)\\s*[a-zA-Z_][a-zA-Z0-9_-]*\\b"
				},
				{
					"name": "support.class.fluentscript",
					"match": "\\b(Mutable|Referred|Dereferred|Console|Math|Event|Thread|Pointer|Conversion|Random|Result|Exception|ConversionException|Encoding)\\b"
				},
				{
					"name": "constant.numeric.fluentscript",
					"match": "\\b\\d+\\.\\d+|\\b\\d+\\b"
				},
				{
					"name": "storage.type.fluentscript",
					"match": "\\b(string|int|int32|int64|double|char|float|float32|float64|boolean|long|await|async|byte|unknown|uint|usize|uint8|uint16|uint32|uint64)\\b"
				}
			]
		},
		"decorators": {
			"patterns": [
				{
					"name": "meta.decorator.fluentscript",
					"match": "@[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.fluentscript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.fluentscript",
					"match": "\\\\."
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.fluentscript",
					"begin": "//",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.fluentscript"
						}
					},
					"end": "$\\n?",
					"patterns": []
				},
				{
					"name": "comment.block.fluentscript",
					"begin": "/\\*",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.fluentscript"
						}
					},
					"end": "\\*/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.fluentscript"
						}
					},
					"patterns": []
				}
			]
		}
	}
}